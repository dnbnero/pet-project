## Secret keys
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__CORE__INTERNAL_API_SECRET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__WEBSERVER__SECRET_KEY=

# Connection strings
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://<user>:<password>@postgres-0.pg.postgres.svc.cluster.local/airflow
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://postgres:airflow@postgres-0.pg.postgres.svc.cluster.local/airflow
AIRFLOW__CELERY__BROKER_URL=redis://valkey:6379/0

# Admin creds
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=
AIRFLOW_CONFIG=/opt/airflow/config/airflow.cfg